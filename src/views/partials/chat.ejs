<dialog id="connection-dialog" class="col-11 col-sm-8 col-lg-5 border rounded-4 shadow p-4 bg-body text-body" aria-labelledby="connection-title" aria-describedby="connection-message">
    <h2 id="connection-title" class="h5">채팅 연결 문제</h2>
    <p id="connection-message" role="status"></p>
    <div class="d-flex flex-wrap gap-2">
        <button id="connection-retry" class="btn btn-primary" type="button">다시 연결</button>
        <a class="btn btn-outline-secondary" href="/login">다시 로그인</a>
        <form method="dialog"><button class="btn btn-outline-secondary">닫기</button></form>
    </div>
</dialog>
<div class="vh-100 d-flex flex-column overflow-hidden">
    <header class="d-flex align-items-center justify-content-between gap-3 border-bottom bg-body p-3 px-md-4 flex-shrink-0">
        <a class="d-inline-flex align-items-center gap-2 fs-4 fw-bold text-primary text-decoration-none text-break" href="/">
            <span class="badge bg-primary text-white rounded-3 fs-4" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chat-left-dots-fill" viewBox="0 0 16 16">
                    <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4.414a1 1 0 0 0-.707.293L.854 15.146A.5.5 0 0 1 0 14.793zm5 4a1 1 0 1 0-2 0 1 1 0 0 0 2 0m4 0a1 1 0 1 0-2 0 1 1 0 0 0 2 0m3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
                </svg>
            </span>
            <%= siteName %>
        </a>
        <details class="position-relative">
            <summary class="d-flex align-items-center gap-2"><span class="badge rounded-pill text-bg-primary p-2"><%= Array.from(user.name)[0] %></span><span class="d-none d-sm-inline text-break"><%= user.name %></span><span class="text-body-secondary" aria-hidden="true">⌄</span></summary>
            <div class="position-absolute end-0 bg-body border rounded-3 shadow p-3 z-3 text-break">
                <p class="fw-semibold mb-1"><%= user.name %></p>
                <p class="small text-body-secondary mb-3">@<%= user.username %></p>
                <a class="d-flex justify-content-between gap-3 border-top pt-3 link-danger text-nowrap" href="/api/auth/logout">로그아웃 <span aria-hidden="true">↗</span></a>
            </div>
        </details>
    </header>
    <div id="connection-status" class="alert alert-warning flex-shrink-0 rounded-0 border-0 border-bottom mb-0 py-2 px-4 small" data-state="connecting" role="status" aria-live="polite" aria-atomic="true">서버 연결 중…</div>
    <div class="row g-0 flex-grow-1 flex-nowrap flex-column flex-md-row overflow-hidden">
        <aside id="room-sidebar" tabindex="-1" aria-labelledby="room-sidebar-title" class="offcanvas-md offcanvas-start col-md-4 col-lg-3 bg-body-tertiary border-end border-bottom p-3 p-lg-4 d-flex flex-column flex-shrink-1 overflow-auto" aria-label="대화 목록">
            <div class="d-flex align-items-center gap-2 mb-3">
                <h2 id="room-sidebar-title" class="h5 mb-0">대화방</h2>
                <span class="me-auto"><span id="room-loading" role="status"><span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span><span class="visually-hidden">대화방을 불러오는 중…</span></span></span>
                <span id="room-count" class="badge text-bg-secondary">…</span>
                <button class="btn-close d-md-none" type="button" data-bs-dismiss="offcanvas" data-bs-target="#room-sidebar" aria-label="대화 목록 닫기"></button>
            </div>
            <button id="new-room" class="btn btn-primary" type="button">새 대화방 만들기</button>
            <p id="room-list-status" class="small text-body-secondary mt-2 mb-0" role="status" aria-live="polite"></p>
            <button id="retry-rooms" class="btn btn-outline-secondary" type="button" hidden>다시 불러오기</button>
            <ul id="room-list" class="list-unstyled my-3" aria-label="참여 중인 대화방" aria-busy="true"></ul>
            <div id="rooms-empty" class="text-center text-body-secondary py-4" hidden><span class="fs-3" aria-hidden="true">☏</span><h3 class="h6">아직 대화가 없어요</h3><p>새 대화방을 만들어 보세요.</p></div>
            <div class="mt-auto border-top pt-3 small text-body-secondary text-break"><span class="badge rounded-pill bg-primary p-1" aria-hidden="true"></span> <strong><%= user.name %></strong> 님으로 로그인 중</div>
        </aside>
        <main class="col-12 col-md-8 col-lg-9 d-flex flex-column flex-grow-1 flex-shrink-1 overflow-hidden bg-body">
            <header class="p-4 border-bottom text-break flex-shrink-0">
                <button id="toggle-rooms" class="btn btn-outline-primary d-md-none mb-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#room-sidebar" aria-controls="room-sidebar"><span aria-hidden="true">☰</span> 대화 목록</button>
                <h1 id="conversation-title" class="h5">우리만의 대화 공간</h1><p class="small text-body-secondary mb-0">반가운 인사로 대화를 시작해 보세요.</p></header>
            <section id="chat-empty" class="flex-grow-1 text-center p-4 overflow-auto" aria-label="선택한 대화 없음">
                <div class="display-1 text-primary mb-3" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-chat-left-dots-fill" viewBox="0 0 16 16">
                        <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4.414a1 1 0 0 0-.707.293L.854 15.146A.5.5 0 0 1 0 14.793zm5 4a1 1 0 1 0-2 0 1 1 0 0 0 2 0m4 0a1 1 0 1 0-2 0 1 1 0 0 0 2 0m3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
                    </svg>
                </div>
                <p class="small fw-semibold text-primary text-uppercase">편하게 머물러 보세요</p>
                <h2 class="h5">안녕하세요, <%= user.name %> 님.</h2>
                <p>이곳에서 안부를 묻고 생각을 나누며 소중한 인연을 이어 가세요.<br>대화 목록에서 이야기를 나눌 대화를 선택해 주세요.</p>
            </section>
            <ol id="messages" data-current-user-id="<%= user.id %>" class="flex-grow-1 list-unstyled overflow-auto p-4 mb-0" aria-live="polite" hidden></ol>
            <p id="message-status" class="small mx-4" role="status"></p>
            <p id="read-status" class="text-danger small mx-4" role="status"></p>
            <button id="retry-messages" class="btn btn-outline-secondary align-self-start mx-4 mb-3" type="button" hidden>다시 불러오기</button>
            <form id="message-form" class="d-flex align-items-center gap-2 m-3 m-md-4 flex-shrink-0">
                <label class="visually-hidden" for="message">메시지</label>
                <textarea class="form-control" id="message" rows="1" maxlength="4000" required placeholder="대화를 선택하고 이야기를 시작하세요" disabled></textarea>
                <button id="send-message" class="btn btn-primary fs-5" type="submit" disabled aria-label="메시지 보내기">↑</button>
            </form>
        </main>
    </div>
</div>
<div id="room-dialog" class="modal fade" tabindex="-1" aria-labelledby="room-dialog-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <form id="room-form" class="modal-content">
            <div class="modal-header">
                <h2 id="room-dialog-title" class="modal-title fs-5">새 대화방 만들기</h2>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="닫기"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" for="room-name">대화방 이름</label>
                <input class="form-control" id="room-name" name="name" maxlength="100" required autocomplete="off">
                <label class="form-label mt-3" for="user-search">이메일 또는 닉네임으로 찾기</label>
                <input class="form-control" id="user-search" type="search" minlength="2" maxlength="100" autocomplete="off" placeholder="2자 이상 입력해 주세요">
                <p id="search-status" role="status" aria-live="polite"></p>
                <ul id="user-results" class="list-unstyled my-3" aria-label="검색 결과"></ul>
                <h3 class="h6">선택한 사용자</h3>
                <ul id="selected-users" class="list-unstyled my-3" aria-label="선택한 사용자"></ul>
                <p id="room-error" class="text-danger small" role="alert"></p>
            </div>
            <div class="modal-footer">
                <button id="cancel-room" class="btn btn-secondary" type="button" data-bs-dismiss="modal">취소</button>
                <button id="create-room" class="btn btn-primary" type="submit">만들기</button>
            </div>
        </form>
    </div>
</div>
