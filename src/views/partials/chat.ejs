<dialog id="connection-dialog" class="connection-dialog" aria-labelledby="connection-title" aria-describedby="connection-message">
    <h2 id="connection-title">채팅 연결 문제</h2>
    <p id="connection-message" role="status"></p>
    <div class="connection-actions">
        <button id="connection-retry" class="button button-primary" type="button">다시 연결</button>
        <a class="button button-secondary" href="/login">다시 로그인</a>
        <form method="dialog"><button class="button button-secondary">닫기</button></form>
    </div>
</dialog>
<div class="chat-shell">
    <header class="chat-header">
        <a class="brand" href="/"><span class="brand-icon" aria-hidden="true">◌</span><%= siteName %></a>
        <details class="account-menu">
            <summary><span class="avatar"><%= Array.from(user.name)[0] %></span><span class="account-name"><%= user.name %></span><span class="chevron" aria-hidden="true">⌄</span></summary>
            <div class="account-dropdown">
                <p class="dropdown-name"><%= user.name %></p>
                <p class="username">@<%= user.username %></p>
                <a class="signout" href="/api/auth/logout">로그아웃 <span aria-hidden="true">↗</span></a>
            </div>
        </details>
    </header>
    <div id="connection-status" class="connection-status" data-state="connecting" role="status" aria-live="polite" aria-atomic="true">서버 연결 중…</div>
    <div class="chat-layout">
        <aside class="sidebar" aria-label="대화 목록">
            <div class="sidebar-heading"><h2>메시지</h2><span id="room-count" class="count">…</span></div>
            <button id="new-room" class="button button-primary" type="button">새 대화방 만들기</button>
            <p id="room-list-status" role="status" aria-live="polite">대화방을 불러오는 중…</p>
            <button id="retry-rooms" class="button button-secondary" type="button" hidden>다시 불러오기</button>
            <ul id="room-list" class="room-list" aria-label="참여 중인 대화방" aria-busy="true"></ul>
            <div id="rooms-empty" class="conversation-placeholder" hidden><span class="empty-icon" aria-hidden="true">☏</span><h3>아직 대화가 없어요</h3><p>새 대화방을 만들어 보세요.</p></div>
            <div class="sidebar-user"><span class="status-dot" aria-hidden="true"></span> <strong><%= user.name %></strong> 님으로 로그인 중</div>
        </aside>
        <main class="chat-main">
            <header class="conversation-header"><h1>우리만의 대화 공간</h1><p>반가운 인사로 대화를 시작해 보세요.</p></header>
            <section class="chat-empty" aria-label="선택한 대화 없음">
                <div class="welcome-icon" aria-hidden="true">◌</div>
                <p class="eyebrow">편하게 머물러 보세요</p>
                <h2>안녕하세요, <%= user.name %> 님.</h2>
                <p>이곳에서 안부를 묻고 생각을 나누며 소중한 인연을 이어 가세요.<br>대화 목록에서 이야기를 나눌 대화를 선택해 주세요.</p>
            </section>
            <div class="composer">
                <label class="sr-only" for="message">메시지</label>
                <textarea id="message" rows="1" placeholder="대화를 선택하고 이야기를 시작하세요" disabled></textarea>
                <button class="send-button" type="button" disabled aria-label="메시지 보내기">↑</button>
            </div>
        </main>
    </div>
</div>
<dialog id="room-dialog" class="connection-dialog" aria-labelledby="room-dialog-title">
    <h2 id="room-dialog-title">새 대화방 만들기</h2>
    <form id="room-form">
        <label for="room-name">대화방 이름</label>
        <input id="room-name" name="name" maxlength="100" required autocomplete="off">
        <label for="user-search">이메일 또는 닉네임으로 찾기</label>
        <input id="user-search" type="search" minlength="2" maxlength="100" autocomplete="off" placeholder="2자 이상 입력해 주세요">
        <p id="search-status" role="status" aria-live="polite"></p>
        <ul id="user-results" class="user-options" aria-label="검색 결과"></ul>
        <h3>선택한 사용자</h3>
        <ul id="selected-users" class="user-options" aria-label="선택한 사용자"></ul>
        <p id="room-error" role="alert"></p>
        <div class="connection-actions">
            <button id="create-room" class="button button-primary" type="submit">만들기</button>
            <button id="cancel-room" class="button button-secondary" type="button">취소</button>
        </div>
    </form>
</dialog>
