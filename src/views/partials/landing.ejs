<div class="landing">
    <header class="landing-header">
        <a class="brand" href="/" aria-label="Home"><span class="brand-icon" aria-hidden="true">◌</span><%= siteName %></a>
        <span class="header-note">Good conversations start here.</span>
    </header>
    <main class="hero">
        <section class="hero-copy">
            <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> A space to connect</p>
            <h1>Your people.<br>Your conversations.<br><span>Your little corner.</span></h1>
            <p class="description">Welcome to <strong><%= siteName %></strong>, an online chatting service for everyday conversations. Catch up with friends, share a thought, and feel a little closer.</p>
            <div class="hero-actions">
                <a class="button button-primary" href="/signup">Sign up <span aria-hidden="true">↗</span></a>
                <a class="button button-secondary" href="/login">Log in</a>
            </div>
        </section>
        <div class="preview" aria-label="An illustration of a friendly conversation">
            <div class="preview-heading"><span class="status-dot" aria-hidden="true"></span> The everyday catch-up <span class="preview-label">Preview</span></div>
            <div class="preview-content">
                <p class="day-label">A little hello goes a long way</p>
                <div class="sample-message"><span class="avatar peach" aria-hidden="true">J</span><div><span class="message-name">Jamie</span><p class="bubble">Hey! How’s your day going? ☀️</p></div></div>
                <div class="sample-message outgoing"><div><span class="message-name">You</span><p class="bubble">Better now that you’re here.</p></div></div>
                <div class="sample-message"><span class="avatar peach" aria-hidden="true">J</span><div><span class="message-name">Jamie</span><p class="bubble">There’s so much to catch up on!</p></div></div>
            </div>
            <div class="preview-footer">Small moments. Real connections.</div>
        </div>
    </main>
    <footer class="landing-footer"><%= siteName %> <span>Made for the moments between everything else.</span></footer>
</div>
