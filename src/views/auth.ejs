<% const isSignup = mode === 'signup'; %>
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= isSignup ? '회원가입' : '로그인' %> · <%= siteName %></title>
    <%- include('partials/bootstrap') %>
    <script src="/js/vendor/validator.min.js" defer></script>
    <script type="module" src="/js/auth.js"></script>
</head>
<body class="bg-body-tertiary">
    <div class="container min-vh-100 d-flex flex-column px-4">
        <header class="d-flex align-items-center justify-content-between gap-3 py-4">
            <a class="d-inline-flex align-items-center gap-2 fs-4 fw-bold text-primary text-decoration-none text-break" href="/">
                <span class="badge bg-primary text-white rounded-3 fs-4" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-chat-left-dots-fill" viewBox="0 0 16 16">
                        <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4.414a1 1 0 0 0-.707.293L.854 15.146A.5.5 0 0 1 0 14.793zm5 4a1 1 0 1 0-2 0 1 1 0 0 0 2 0m4 0a1 1 0 1 0-2 0 1 1 0 0 0 2 0m3 1a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
                    </svg>
                </span>
                <%= siteName %>
            </a>
            <a class="link-secondary small text-nowrap" href="/">홈으로 <span aria-hidden="true">↗</span></a>
        </header>
        <main class="row justify-content-center align-items-center flex-grow-1 py-4">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <section class="card border shadow-sm rounded-4 p-4 p-sm-5" aria-labelledby="auth-title">
                    <p class="small fw-semibold text-primary text-uppercase"><%= isSignup ? '새로운 대화가 시작되는 곳' : '언제나 편안한 우리만의 공간' %></p>
                    <h1 id="auth-title" class="h2 mb-3"><%= isSignup ? '편하게 머물러 보세요.' : '다시 만나 반가워요.' %></h1>
                    <p class="text-body-secondary text-break mb-4"><%= siteName %>에서 <%= isSignup ? '계정을 만들고 소중한 사람들과 만나 보세요.' : '로그인하고 소중한 사람들과 이야기를 나눠 보세요.' %></p>
                    <form id="auth-form" method="post" action="<%= isSignup ? '/api/auth/create-account' : '/api/auth/login' %>" data-mode="<%= mode %>" data-password-rules="<%= JSON.stringify(passwordRules) %>">
                        <div id="form-error" class="alert alert-danger" role="alert" tabindex="-1" hidden></div>
                        <% if (isSignup) { %>
                            <div class="mb-3">
                                <label class="form-label mt-3" for="name">표시 이름 <span class="text-body-secondary fw-normal">(선택)</span></label>
                                <input class="form-control" id="name" name="name" type="text" autocomplete="name" placeholder="어떤 이름으로 불러 드릴까요?">
                            </div>
                            <div class="mb-3">
                                <label class="form-label mt-3" for="username">사용자 아이디</label>
                                <input class="form-control" id="username" name="username" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required aria-describedby="username-error" placeholder="사용할 아이디를 입력하세요">
                                <p id="username-error" class="invalid-feedback" hidden></p>
                            </div>
                        <% } %>
                        <div class="mb-3">
                            <label class="form-label mt-3" for="email">이메일</label>
                            <input class="form-control" id="email" name="email" type="email" autocomplete="<%= isSignup ? 'email' : 'username' %>" autocapitalize="none" spellcheck="false" required aria-describedby="email-error" placeholder="you@example.com">
                            <p id="email-error" class="invalid-feedback" hidden></p>
                        </div>
                        <div class="mb-3">
                            <label class="form-label mt-3" for="password">비밀번호</label>
                            <input class="form-control" id="password" name="password" type="password" autocomplete="<%= isSignup ? 'new-password' : 'current-password' %>" required <% if (isSignup) { %>minlength="<%= passwordRules.minLength %>"<% } %> aria-describedby="<%= isSignup ? 'password-help password-strength password-error' : 'password-error' %>">
                            <% if (isSignup) { %>
                                <p id="password-help" class="form-text">영문 소문자와 대문자, 숫자, 특수문자(예: !, @, #)를 포함해 <%= passwordRules.minLength %>자 이상 입력하세요.</p>
                                <p id="password-strength" class="form-text" role="status" aria-live="polite"></p>
                            <% } %>
                            <p id="password-error" class="invalid-feedback" hidden></p>
                        </div>
                        <button class="btn btn-primary w-100 d-flex justify-content-between mt-4" type="submit"><%= isSignup ? '회원가입' : '로그인' %><span aria-hidden="true">↗</span></button>
                    </form>
                    <p class="text-center text-body-secondary small mt-4 mb-0"><%= isSignup ? '이미 계정이 있으신가요?' : '처음 오셨나요?' %> <a href="<%= isSignup ? '/login' : '/signup' %>"><%= isSignup ? '로그인' : '회원가입' %></a></p>
                </section>
            </div>
        </main>
        <footer class="border-top py-4 d-flex flex-column flex-sm-row justify-content-between gap-2 small text-body-secondary"><%= siteName %><span>작은 순간이 만드는 진심 어린 만남.</span></footer>
    </div>
</body>
</html>
