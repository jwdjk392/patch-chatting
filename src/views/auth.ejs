<% const isSignup = mode === 'signup'; %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= isSignup ? 'Sign up' : 'Log in' %> · <%= siteName %></title>
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/auth.css">
    <script src="/js/vendor/validator.min.js" defer></script>
    <script type="module" src="/js/auth.js"></script>
</head>
<body>
    <div class="auth-page">
        <header class="landing-header">
            <a class="brand" href="/"><span class="brand-icon" aria-hidden="true">◌</span><%= siteName %></a>
            <a class="back-link" href="/">Back to home <span aria-hidden="true">↗</span></a>
        </header>
        <main class="auth-main">
            <section class="auth-card" aria-labelledby="auth-title">
                <p class="eyebrow"><%= isSignup ? 'Your next conversation starts here' : 'A familiar little corner' %></p>
                <h1 id="auth-title"><%= isSignup ? 'Make yourself at home.' : 'Welcome back.' %></h1>
                <p class="auth-description"><%= isSignup ? 'Create an account and find your people on ' : 'Log in to catch up with your people on ' %><%= siteName %>.</p>
                <form id="auth-form" method="post" action="<%= isSignup ? '/api/auth/create-account' : '/api/auth/login' %>" data-mode="<%= mode %>" data-password-rules="<%= JSON.stringify(passwordRules) %>">
                    <div id="form-error" class="form-error" role="alert" tabindex="-1" hidden></div>
                    <% if (isSignup) { %>
                        <div class="form-field">
                            <label for="name">Display name <span class="optional">(optional)</span></label>
                            <input id="name" name="name" type="text" autocomplete="name" placeholder="What should we call you?">
                        </div>
                        <div class="form-field">
                            <label for="username">Username</label>
                            <input id="username" name="username" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required aria-describedby="username-error" placeholder="Your unique username">
                            <p id="username-error" class="field-error" hidden></p>
                        </div>
                    <% } %>
                    <div class="form-field">
                        <label for="email">Email</label>
                        <input id="email" name="email" type="email" autocomplete="<%= isSignup ? 'email' : 'username' %>" autocapitalize="none" spellcheck="false" required aria-describedby="email-error" placeholder="you@example.com">
                        <p id="email-error" class="field-error" hidden></p>
                    </div>
                    <div class="form-field">
                        <label for="password">Password</label>
                        <input id="password" name="password" type="password" autocomplete="<%= isSignup ? 'new-password' : 'current-password' %>" required <% if (isSignup) { %>minlength="<%= passwordRules.minLength %>"<% } %> aria-describedby="<%= isSignup ? 'password-help password-strength password-error' : 'password-error' %>">
                        <% if (isSignup) { %>
                            <p id="password-help" class="field-hint">Use at least <%= passwordRules.minLength %> characters, including a lowercase letter, an uppercase letter, a number, and a symbol (such as !, @, or #).</p>
                            <p id="password-strength" class="password-strength" role="status" aria-live="polite"></p>
                        <% } %>
                        <p id="password-error" class="field-error" hidden></p>
                    </div>
                    <button class="button button-primary auth-submit" type="submit"><%= isSignup ? 'Create account' : 'Log in' %><span aria-hidden="true">↗</span></button>
                </form>
                <p class="auth-switch"><%= isSignup ? 'Already have an account?' : 'New here?' %> <a href="<%= isSignup ? '/login' : '/signup' %>"><%= isSignup ? 'Log in' : 'Create an account' %></a></p>
            </section>
        </main>
        <footer class="landing-footer"><%= siteName %><span>Small moments. Real connections.</span></footer>
    </div>
</body>
</html>
