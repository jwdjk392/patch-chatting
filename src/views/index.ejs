<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="즐거운 대화를 위한 작은 공간. 소중한 사람들과 이야기를 나눠 보세요.">
    <title><%= siteName %></title>
    <link rel="stylesheet" href="/css/home.css">
</head>
<body>
    <% if (user) { %>
        <%- include('partials/chat', { siteName, user }) %>
        <script src="/socket.io/socket.io.js" defer></script>
        <script src="/js/chat.js" defer></script>
        <script src="/js/chat-rooms.js" defer></script>
        <script src="/js/messages.js" defer></script>
    <% } else { %>
        <%- include('partials/landing', { siteName }) %>
    <% } %>
</body>
</html>
